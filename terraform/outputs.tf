output "site_url" {
  description = "The site's URL."
  value       = "https://${var.domain_name}/"
}

output "bucket_name" {
  description = "The S3 bucket to upload the generated site to."
  value       = aws_s3_bucket.site.id
}

output "distribution_id" {
  description = "The CloudFront distribution ID, for cache invalidations."
  value       = aws_cloudfront_distribution.site.id
}

output "distribution_domain_name" {
  description = "The distribution's cloudfront.net host name."
  value       = aws_cloudfront_distribution.site.domain_name
}

output "upload_commands" {
  description = "Commands to publish a site generated by homebrew-catalog-static-pages into ./site (not run by Terraform)."
  value       = <<-EOT
    # Stylesheets have content-hashed names, so they can be cached for a year; pages are cached for 4 hours.
    # Assets are uploaded first and old ones are kept (no --delete), so pages still cached elsewhere keep working.
    aws s3 sync site/assets s3://${aws_s3_bucket.site.id}/assets/ --cache-control "public, max-age=31536000, immutable"
    # The catalog is kept at the bucket root (the update function reads it), so it's excluded from the deletion.
    aws s3 cp formula-catalogged.json s3://${aws_s3_bucket.site.id}/${local.catalog_key} --content-type application/json --cache-control "public, max-age=14400"
    aws s3 sync site s3://${aws_s3_bucket.site.id}/ --delete --exclude "assets/*" --exclude "${local.catalog_key}" --cache-control "public, max-age=14400"
    aws cloudfront create-invalidation --distribution-id ${aws_cloudfront_distribution.site.id} --paths "/*"
  EOT
}

output "update_function_name" {
  description = "The site update Lambda function, when enable_automation is true."
  value       = one(aws_lambda_function.update[*].function_name)
}

output "catalog_url" {
  description = "The classified catalog the site is built from (and the update function maintains)."
  value       = "https://${var.domain_name}/${local.catalog_key}"
}
